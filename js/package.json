{
  "name": "@spanly/sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "test": "jest --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@swc/core": "^1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/node": "^20.0.0",
    "eslint": "^9.8.0",
    "jest": "^29.7.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0"
  },
  "nx": {
    "targets": {
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    },
    "name": "@spanly/sdk"
  }
}
